# ============================================================================
# Cloud Fuel & Dispensing Platform — environment template
# Copy to .env and adjust for your deployment.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=dev
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
INGESTION_PORT=8001

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (TimescaleDB/PostgreSQL) ---------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fuel_platform
POSTGRES_USER=fuel_platform
POSTGRES_PASSWORD=CHANGE_ME
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- MQTT / EMQX -------------------------------------------------------------
MQTT_BROKER=emqx
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_QOS=1
MQTT_KEEPALIVE=60

# --- Dispensing --------------------------------------------------------------
CODE_LENGTH_MIN=6
CODE_LENGTH_MAX=8
CODE_TTL_DAYS=7
CODE_MAX_ATTEMPTS=5
CODE_RATE_LIMIT_PER_MIN=10
DISPENSE_GRACE_LITERS=0.5
PARTIAL_MIN_REMAINING_LITERS=1.0
TOTALIZER_DISCREPANCY_TOLERANCE_LITERS=1.0

# --- Notifications -----------------------------------------------------------
DEFAULT_NOTIFICATION_CHANNEL=sms        # sms | whatsapp
NOTIFY_MAX_RETRIES=3
NOTIFY_RETRY_BACKOFF=5

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0